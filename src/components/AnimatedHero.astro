---
import profile from '../../data/profile.json';
---

<section
  id="hero"
  class="relative min-h-[100svh] flex items-center overflow-hidden pt-[calc(4rem+env(safe-area-inset-top))]"
>
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <div class="max-w-5xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-500/10 border border-primary-500/20 backdrop-blur-sm mb-6 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
        </span>
        <span class="text-sm font-mono text-primary-700 dark:text-primary-300">
          Available for opportunities
        </span>
      </div>

      <h1 class="text-[clamp(2.75rem,11vw,8rem)] font-bold mb-6 tracking-tight leading-none animate-slide-up">
        <span class="block bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 dark:from-white dark:via-gray-200 dark:to-white bg-clip-text text-transparent">
          {profile.name.split(' ')[0]}
        </span>
        <span class="block bg-gradient-to-r from-primary-600 via-primary-500 to-primary-600 bg-clip-text text-transparent">
          {profile.name.split(' ')[1]}
        </span>
      </h1>

      <p
        class="text-[clamp(1.375rem,4.5vw,2.25rem)] font-light text-gray-600 dark:text-gray-400 mb-4 animate-slide-up"
        style="animation-delay: 0.1s"
      >
        {profile.title}
      </p>

      <p
        class="text-lg md:text-xl text-gray-700 dark:text-gray-300 mb-8 max-w-3xl leading-relaxed animate-slide-up"
        style="animation-delay: 0.2s"
      >
        {profile.tagline}
      </p>

      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-mono text-gray-600 dark:text-gray-400 mb-10 animate-slide-up"
        style="animation-delay: 0.3s"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            />
          </svg>
          {profile.location.split(',')[0]}
        </span>
        <span class="text-gray-400 dark:text-gray-600">•</span>
        <span>4.5+ years experience</span>
      </div>

      <div
        class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:gap-4 animate-slide-up"
        style="animation-delay: 0.4s"
      >
        <a
          href={profile.links.resume}
          class="col-span-2 sm:col-auto group relative inline-flex justify-center px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-medium transition-all hover:shadow-lg hover:shadow-primary-500/50 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950"
        >
          <span class="relative z-10 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
            Download Resume
          </span>
        </a>

        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex justify-center px-5 sm:px-8 py-4 border-2 border-gray-300 dark:border-gray-700 hover:border-primary-600 dark:hover:border-primary-400 rounded-xl font-medium transition-all hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 backdrop-blur-sm bg-white/50 dark:bg-gray-900/50"
        >
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            GitHub
          </span>
        </a>

        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex justify-center px-5 sm:px-8 py-4 border-2 border-gray-300 dark:border-gray-700 hover:border-primary-600 dark:hover:border-primary-400 rounded-xl font-medium transition-all hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 backdrop-blur-sm bg-white/50 dark:bg-gray-900/50"
        >
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-[max(2rem,env(safe-area-inset-bottom))] left-1/2 -translate-x-1/2 animate-bounce motion-reduce:animate-none hidden sm:block [@media(max-height:700px)]:hidden">
    <a
      href="#highlights"
      class="flex flex-col items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
      aria-label="Scroll to explore highlights"
    >
      <span class="font-mono text-xs">Scroll to explore</span>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </a>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let animationId: number;
      let nodes: Array<{ x: number; y: number; vx: number; vy: number }> = [];
      // Cached canvas size (from ResizeObserver) so the draw loop never forces a layout
      let width = 0;
      let height = 0;
      let running = false;
      let visible = true;

      const resize = () => {
        const dpr = window.devicePixelRatio;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const init = () => {
        const nodeCount = Math.min(50, Math.floor((width * height) / 15000));
        nodes = Array.from({ length: nodeCount }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
        }));
      };

      const draw = () => {
        const isDark = document.documentElement.classList.contains('dark');
        ctx.clearRect(0, 0, width, height);

        nodes.forEach((node) => {
          node.x += node.vx;
          node.y += node.vy;

          if (node.x < 0 || node.x > width) node.vx *= -1;
          if (node.y < 0 || node.y > height) node.vy *= -1;

          ctx.beginPath();
          ctx.arc(node.x, node.y, 2, 0, Math.PI * 2);
          ctx.fillStyle = isDark ? 'rgba(96, 165, 250, 0.4)' : 'rgba(37, 99, 235, 0.3)';
          ctx.fill();
        });

        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const dx = nodes[i].x - nodes[j].x;
            const dy = nodes[i].y - nodes[j].y;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < 150) {
              ctx.beginPath();
              ctx.moveTo(nodes[i].x, nodes[i].y);
              ctx.lineTo(nodes[j].x, nodes[j].y);
              ctx.strokeStyle = isDark
                ? `rgba(96, 165, 250, ${0.15 * (1 - distance / 150)})`
                : `rgba(37, 99, 235, ${0.1 * (1 - distance / 150)})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }
      };

      const animate = () => {
        draw();
        animationId = requestAnimationFrame(animate);
      };

      const start = () => {
        if (running || !visible || width === 0) return;
        running = true;
        animationId = requestAnimationFrame(animate);
      };

      const stop = () => {
        running = false;
        cancelAnimationFrame(animationId);
      };

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const resizeObserver = new ResizeObserver((entries) => {
          const rect = entries[0].contentRect;
          width = rect.width;
          height = rect.height;
          resize();
          init();
          start();
        });
        resizeObserver.observe(canvas);

        // Pause the animation while the hero is off-screen
        const visibilityObserver = new IntersectionObserver((entries) => {
          visible = entries[0].isIntersecting;
          if (visible) start();
          else stop();
        });
        visibilityObserver.observe(canvas);

        const observer = new MutationObserver(() => {
          draw();
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      }
    }
  }
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .animate-slide-up {
    animation: slide-up 0.8s ease-out forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in,
    .animate-slide-up {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
