<script>
  // Final values are rendered in the HTML (crawlers, no-JS, screen readers via .sr-only).
  // The count-up is a progressive enhancement: only for counters still off-screen when
  // the script runs, and never under prefers-reduced-motion. Width is reserved with
  // tabular-nums + min-width (ch), so the layout box never changes.
  const section = document.getElementById('highlights');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const format = (value: number, target: number) =>
    value.toLocaleString('en-US') + (target >= 1000 && value >= target ? '+' : '');

  const animate = (counter: HTMLElement) => {
    const target = parseInt(counter.dataset.counter || '0', 10);
    const duration = 1500;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      counter.textContent = format(t < 1 ? Math.floor(target * eased) : target, target);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (section && !reduceMotion && 'IntersectionObserver' in window) {
    const counters = Array.from(section.querySelectorAll<HTMLElement>('[data-counter]'));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const counter = entry.target as HTMLElement;
          if (counter.dataset.counterState === undefined) {
            // First report: already visible -> keep the final value, no animation.
            if (entry.isIntersecting) {
              counter.dataset.counterState = 'done';
              observer.unobserve(counter);
            } else {
              counter.dataset.counterState = 'pending';
              counter.textContent = '0';
            }
            return;
          }
          if (entry.isIntersecting && counter.dataset.counterState === 'pending') {
            counter.dataset.counterState = 'done';
            observer.unobserve(counter);
            animate(counter);
          }
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((counter) => observer.observe(counter));
  }
</script>
