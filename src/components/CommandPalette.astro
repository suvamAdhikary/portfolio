---
---

<div
  id="command-palette"
  class="fixed inset-0 z-50 hidden items-start sm:items-center justify-center bg-black/50 backdrop-blur-sm p-3 pt-[max(1rem,env(safe-area-inset-top))] sm:p-4 overscroll-contain"
  role="dialog"
  aria-modal="true"
  aria-label="Quick navigation"
>
  <div class="w-full max-w-2xl bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 overflow-hidden animate-scale-in">
    <div class="border-b border-gray-200 dark:border-gray-800 p-4">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <input
          type="text"
          id="command-input"
          placeholder="Jump to a section…"
          autocomplete="off"
          enterkeyhint="go"
          class="flex-1 bg-transparent border-none outline-none text-base sm:text-lg min-h-11 placeholder:text-gray-400 dark:placeholder:text-gray-600"
          aria-label="Search navigation"
        />
        <button
          type="button"
          id="command-close"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-xs font-mono text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-primary-500"
          aria-label="Esc, close search"
        >
          <span class="hidden sm:inline">ESC</span>
          <svg
            class="w-4 h-4 sm:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="command-results"
      class="max-h-[min(24rem,calc(100dvh-8rem))] overflow-y-auto overscroll-contain p-2"
    >
      <div class="text-xs font-mono text-gray-500 dark:text-gray-400 px-3 py-2">
        Quick Navigation
      </div>
    </div>
  </div>
</div>

<script>
  const palette = document.getElementById('command-palette');
  const input = document.getElementById('command-input') as HTMLInputElement;
  const results = document.getElementById('command-results');

  const commands = [
    { name: 'About', section: 'about', icon: '👤' },
    { name: 'Experience', section: 'experience', icon: '💼' },
    { name: 'Case Studies', section: 'case-studies', icon: '📚' },
    { name: 'Projects', section: 'projects', icon: '🚀' },
    { name: 'Builds', section: 'builds', icon: '\u{1F3AE}' },
    { name: 'Skills', section: 'skills', icon: '⚡' },
    { name: 'Education', section: 'education', icon: '🎓' },
    { name: 'Contact', section: 'contact', icon: '✉️' },
  ];

  let selectedIndex = 0;
  let lastFocus: HTMLElement | null = null;
  // Section anchors live on the home page; elsewhere link back to it.
  const hashPrefix = window.location.pathname === '/' ? '' : '/';

  const renderResults = (filter: string = '') => {
    if (!results) return;

    const filtered = commands.filter((cmd) =>
      cmd.name.toLowerCase().includes(filter.toLowerCase())
    );

    if (filtered.length === 0) {
      results.innerHTML =
        '<div class="px-3 py-8 text-center text-gray-500 dark:text-gray-400">No results found</div>';
      return;
    }

    results.innerHTML = filtered
      .map(
        (cmd, idx) => `
      <a 
        href="${hashPrefix}#${cmd.section}"
        class="command-item flex min-h-12 items-center gap-3 px-3 py-3 rounded-lg transition-colors ${idx === selectedIndex ? 'bg-primary-100 dark:bg-primary-900/30' : 'hover:bg-gray-100 dark:hover:bg-gray-800'}"
        data-index="${idx}"
      >
        <span class="text-2xl" aria-hidden="true">${cmd.icon}</span>
        <span class="flex-1 font-medium">${cmd.name}</span>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    `
      )
      .join('');

    const items = results.querySelectorAll('.command-item');
    items.forEach((item) => {
      item.addEventListener('click', () => {
        lastFocus = null;
        closePalette();
      });
    });
  };

  const openPalette = () => {
    if (!palette || !input) return;
    lastFocus = document.activeElement as HTMLElement | null;
    palette.classList.remove('hidden');
    palette.classList.add('flex');
    document.documentElement.style.overflow = 'hidden';
    input.value = '';
    input.focus();
    selectedIndex = 0;
    renderResults();
  };

  const closePalette = () => {
    if (!palette) return;
    palette.classList.add('hidden');
    palette.classList.remove('flex');
    document.documentElement.style.overflow = '';
    lastFocus?.focus({ preventScroll: true });
  };

  document.addEventListener('open-command-palette', openPalette);
  document.getElementById('command-close')?.addEventListener('click', closePalette);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openPalette();
    }

    if (e.key === 'Escape' && palette && !palette.classList.contains('hidden')) {
      closePalette();
    }
  });

  if (input) {
    input.addEventListener('input', (e) => {
      selectedIndex = 0;
      renderResults((e.target as HTMLInputElement).value);
    });

    input.addEventListener('keydown', (e) => {
      const items = results?.querySelectorAll('.command-item');
      if (!items) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        renderResults(input.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        renderResults(input.value);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const selected = items[selectedIndex] as HTMLAnchorElement;
        if (selected) {
          selected.click();
        }
      }
    });
  }

  if (palette) {
    palette.addEventListener('click', (e) => {
      if (e.target === palette) {
        closePalette();
      }
    });
  }
</script>

<style>
  @keyframes scale-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-scale-in {
    animation: scale-in 0.2s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scale-in {
      animation: none;
    }
  }
</style>
