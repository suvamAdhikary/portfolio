---
import profile from '../../data/profile.json';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-bold text-lg mb-4">{profile.name}</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm">
          {profile.title} based in {profile.location}
        </p>
      </div>
      
      <div>
        <h4 class="font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/#about" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">About</a></li>
          <li><a href="/#experience" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Experience</a></li>
          <li><a href="/#case-studies" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Case Studies</a></li>
          <li><a href="/#projects" class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Projects</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-semibold mb-4">Connect</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a 
              href={profile.links.github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a 
              href={profile.links.linkedin} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a 
              href={`mailto:${profile.email}`}
              class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-sm text-gray-600 dark:text-gray-400">
      <p>&copy; {currentYear} {profile.name}. Built with Astro and Tailwind CSS.</p>
    </div>
  </div>
</footer>
