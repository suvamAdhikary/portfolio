---
import profile from '../../data/profile.json';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-20">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-[max(3rem,calc(env(safe-area-inset-bottom)+1.5rem))]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-bold text-lg mb-4">{profile.name}</h3>
        <p class="text-gray-600 dark:text-gray-400 text-sm">
          {profile.title} based in {profile.location}
        </p>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Quick Links</h4>
        <ul class="text-sm">
          <li>
            <a
              href="/#about"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/#experience"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Experience
            </a>
          </li>
          <li>
            <a
              href="/#case-studies"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Case Studies
            </a>
          </li>
          <li>
            <a
              href="/#projects"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Projects
            </a>
          </li>
          <li>
            <a
              href="/#builds"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Builds
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-4">Connect</h4>
        <ul class="text-sm">
          <li>
            <a
              href={profile.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={profile.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex min-h-11 items-center text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-sm text-gray-600 dark:text-gray-400">
      <p>
        &copy; {currentYear} {profile.name}. Built with Astro and Tailwind CSS.
      </p>
    </div>
  </div>
</footer>

<a
  href="#top"
  id="back-to-top"
  class="fixed z-30 right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] inline-flex h-12 w-12 items-center justify-center rounded-full border border-gray-200 dark:border-white/10 bg-white/90 dark:bg-gray-900/90 text-gray-700 dark:text-gray-200 shadow-lg backdrop-blur transition-opacity duration-300 opacity-0 pointer-events-none hover:text-primary-600 dark:hover:text-primary-400"
  aria-label="Back to top"
  tabindex="-1"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
  </svg>
</a>

<script>
  const backToTop = document.getElementById('back-to-top');
  const toggleBackToTop = () => {
    const show = window.scrollY > window.innerHeight;
    backToTop?.classList.toggle('opacity-0', !show);
    backToTop?.classList.toggle('pointer-events-none', !show);
    backToTop?.setAttribute('tabindex', show ? '0' : '-1');
  };
  window.addEventListener('scroll', toggleBackToTop, { passive: true });
  backToTop?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    history.replaceState(null, '', window.location.pathname + window.location.search);
    document.querySelector<HTMLElement>('#main-header a')?.focus({ preventScroll: true });
  });
</script>
