---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-950/80 backdrop-blur-sm">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a
        href="/"
        class="text-xl font-bold hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
      >
        SA
      </a>

      <div class="flex items-center gap-6">
        <a
          href="/#about"
          class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors hidden sm:inline-block"
        >
          About
        </a>
        <a
          href="/#experience"
          class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors hidden sm:inline-block"
        >
          Experience
        </a>
        <a
          href="/#case-studies"
          class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors hidden sm:inline-block"
        >
          Case Studies
        </a>
        <a
          href="/#projects"
          class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors hidden sm:inline-block"
        >
          Projects
        </a>
        <a
          href="/#contact"
          class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors hidden sm:inline-block"
        >
          Contact
        </a>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>
