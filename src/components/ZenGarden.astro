---
// A living karesansui: an interactive picture of the event-driven systems I build.
// The canvas script is loaded on demand (see the script below), so it adds almost nothing to
// the initial page load. A static picture stands in for no-JS visitors (<noscript>) and, after
// the page has loaded, until the canvas has drawn (<template>, so it never competes with LCP).
import { getImage } from 'astro:assets';
import ZenGardenPicture from './ZenGardenPicture.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/garden/*.webp', {
  eager: true,
});
const src = (name: string) => images[`../assets/garden/${name}.webp`]?.default;

const variants = async (theme: 'light' | 'dark') => {
  const wide = src(`garden-${theme}-wide`);
  const tall = src(`garden-${theme}-tall`);
  if (!wide || !tall) return null;
  const [w, t] = await Promise.all([
    getImage({ src: wide, widths: [640, 960, 1280, 1600], format: 'webp', quality: 60 }),
    getImage({ src: tall, widths: [400, 686], format: 'webp', quality: 60 }),
  ]);
  return { w, t };
};
const [light, dark] = await Promise.all([variants('light'), variants('dark')]);

const canvasLabel =
  'A top-down Japanese rock garden that changes with the seasons: raked sand, moss islands with stones, streams carrying floating lanterns, a koi pond with a red bridge, a stone lantern and a seasonal tree. Each stone stands for a real system: Payments and a GraphQL gateway send lanterns, standing for events, down the streams into the Kafka pond, then on to Consumers and into the MongoDB pond.';

const seasons = [
  { id: 'spring', kanji: '春', name: 'Spring' },
  { id: 'summer', kanji: '夏', name: 'Summer' },
  { id: 'autumn', kanji: '秋', name: 'Autumn' },
  { id: 'winter', kanji: '冬', name: 'Winter' },
];
---

<section
  id="garden"
  data-zen-garden
  aria-labelledby="garden-title"
  class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-20"
>
  <div class="inline-block mb-4">
    <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
      Systems
    </span>
    <span class="ml-2 text-xs font-mono text-gray-600 dark:text-gray-400" lang="ja">
      流れ <span lang="en">· flow</span>
    </span>
  </div>
  <h2 id="garden-title" class="text-4xl md:text-5xl font-bold mb-4">
    A quiet garden of busy systems
  </h2>
  <p class="text-xl text-gray-600 dark:text-gray-400 mb-6 max-w-3xl">
    The backend I build is meant to feel like this: calm on the surface while events keep moving
    underneath.
  </p>

  <div class="zg-seasons" role="group" aria-label="Season">
    {seasons.map((s) => (
      <button type="button" data-garden-season={s.id} aria-pressed="false">
        <span class="zg-kanji" lang="ja" aria-hidden="true">
          {s.kanji}
        </span>
        <span class="zg-season-name">{s.name}</span>
      </button>
    ))}
  </div>

  <figure class="zg-garden m-0" data-garden-root>
    {light && (
      <noscript>
        <ZenGardenPicture wide={light.w} tall={light.t} />
      </noscript>
    )}
    {light && dark && (
      <template data-garden-fallback>
        <ZenGardenPicture wide={light.w} tall={light.t} theme="light" />
        <ZenGardenPicture wide={dark.w} tall={dark.t} theme="dark" />
      </template>
    )}
    <canvas role="img" aria-label={canvasLabel}></canvas>
  </figure>
  <div class="zg-caption">
    <p class="text-sm text-gray-600 dark:text-gray-400">
      Each stone is a kind of system I build. Events flow from producers through Kafka to consumers,
      staying calm under load and recovering from failure.
    </p>
    <span class="zg-hint text-gray-600 dark:text-gray-400" id="garden-hint">
      Drag to rake the sand. Tap a stone to add load, hold it to break it.
    </span>
  </div>
  <p class="zg-status text-gray-700 dark:text-gray-300" id="garden-status" aria-live="polite"></p>
</section>

<script>
  // Lazy init: only when the garden nears the viewport, then in idle time, via dynamic import.
  const section = document.querySelector<HTMLElement>('[data-zen-garden]');
  const figure = section?.querySelector<HTMLElement>('[data-garden-root]');

  const whenIdle = (cb: () => void) =>
    typeof window.requestIdleCallback === 'function'
      ? window.requestIdleCallback(cb, { timeout: 2000 })
      : setTimeout(cb, 200);

  // Placeholder picture: inserted after load (or as soon as the garden is near), never before LCP
  let placed = false;
  const placeFallback = () => {
    if (placed || !section || !figure || section.dataset.ready) return;
    placed = true;
    const tpl = figure.querySelector<HTMLTemplateElement>('template[data-garden-fallback]');
    if (tpl) figure.insertBefore(tpl.content.cloneNode(true), figure.querySelector('canvas'));
  };

  const boot = async () => {
    if (!section || !figure) return;
    try {
      const { mountGarden } = await import('../scripts/zen-garden');
      mountGarden(figure, document.getElementById('garden-status'), 'garden-hint');
      section.dataset.ready = 'true';
    } catch (err) {
      // Keep the static picture if Canvas 2D is unavailable or the chunk fails to load.
      placeFallback();
      console.warn('Zen garden did not start:', err);
    }
  };

  if (document.readyState === 'complete') whenIdle(placeFallback);
  else window.addEventListener('load', () => whenIdle(placeFallback), { once: true });

  if (figure && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        placeFallback();
        whenIdle(boot);
      },
      { rootMargin: '0px 0px 200px 0px' }
    );
    io.observe(figure);
  } else {
    placeFallback();
  }
</script>

<style is:global>
  .zg-garden {
    position: relative;
    width: 100%;
    border-radius: 1.25rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: min(78svh, 640px);
    min-height: 240px;
    background: #e9e2cf;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px -18px rgb(40 30 15 / 0.35);
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .dark .zg-garden {
    background: #2a2f45;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 16px 40px -20px rgb(0 0 0 / 0.8);
  }
  @media (max-width: 560px) {
    .zg-garden {
      aspect-ratio: 4 / 5;
      border-radius: 1rem;
    }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .zg-garden {
      aspect-ratio: auto;
      height: 76svh;
    }
  }
  .zg-garden canvas,
  .zg-garden .zg-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .zg-garden .zg-fallback {
    object-fit: cover;
    object-position: center;
  }
  .zg-garden canvas {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  [data-zen-garden][data-ready] .zg-garden canvas {
    opacity: 1;
  }
  .zg-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Real buttons for keyboard and screen readers; pointer input goes to the canvas */
  .zg-hit {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 0;
    padding: 0;
    margin: 0;
    background: transparent;
    pointer-events: none;
  }
  .zg-hit-lamp {
    border-radius: 8px;
  }
  .zg-hit:focus-visible {
    outline: 2px solid #fff;
    box-shadow: 0 0 0 4px var(--color-primary-500);
  }
  .zg-label {
    position: absolute;
    transform: translate(-50%, 0);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: #3f3528;
    pointer-events: none;
    padding: 3px 6px;
    border-radius: 4px;
    background: rgb(252 248 238 / 0.88);
    border: 1px solid rgb(120 98 66 / 0.2);
    box-shadow: 0 1px 2px rgb(60 40 20 / 0.12);
  }
  .dark .zg-label {
    color: #e7dcc6;
    background: rgb(20 18 26 / 0.72);
    border-color: rgb(255 200 130 / 0.18);
  }
  .zg-label b {
    font-weight: 500;
    color: inherit;
  }
  .zg-label .zg-st {
    margin-left: 0.45em;
    color: #1e6fc4;
  }
  .dark .zg-label .zg-st {
    color: #ffcf7a;
  }
  .zg-label.zg-down .zg-st {
    color: #c2410c;
  }
  .dark .zg-label.zg-down .zg-st {
    color: #ff8a5c;
  }
  .zg-label .zg-st:empty {
    display: none;
  }
  @media (min-width: 900px) {
    .zg-label {
      font-size: 11.5px;
    }
  }
  .zg-seasons {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    margin-bottom: 0.75rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.04);
    border: 1px solid rgb(0 0 0 / 0.08);
  }
  .dark .zg-seasons {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.1);
  }
  .zg-seasons button {
    position: relative;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 0.8rem;
    font-weight: 500;
    color: #374151;
    cursor: pointer;
  }
  .dark .zg-seasons button {
    color: #d1d5db;
  }
  .zg-seasons button[aria-pressed='true'] {
    background: #fff;
    color: #111827;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .dark .zg-seasons button[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .zg-seasons button.zg-now::after {
    content: '';
    position: absolute;
    top: 5px;
    right: 5px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c2410c;
  }
  .zg-seasons button:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }
  .zg-kanji {
    font-size: 0.95rem;
    line-height: 1;
  }
  @media (max-width: 420px) {
    .zg-season-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  /* The switcher and hint only make sense once the garden is interactive */
  [data-zen-garden]:not([data-ready]) .zg-seasons {
    visibility: hidden;
  }
  .zg-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.9rem;
  }
  .zg-caption p {
    margin: 0;
    line-height: 1.55;
    max-width: 40rem;
  }
  .zg-hint,
  .zg-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  /* The hint only makes sense once the stones are interactive */
  [data-zen-garden]:not([data-ready]) .zg-hint {
    visibility: hidden;
  }
  .zg-status {
    min-height: 1.2em;
    margin-top: 0.35rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .zg-garden canvas {
      transition: none;
    }
  }
</style>
