---
interface Props {
  title: string;
  description: string;
  /** Site-relative social card (1200x630 PNG, see src/lib/seo.ts). Defaults to the home card. */
  ogImage?: string;
  /** Alt text of the social card, in the page's language. */
  ogImageAlt?: string;
  canonicalURL?: string;
  ogType?: 'website' | 'article';
  /** Defaults to the locale of the URL (`/ja/...` is Japanese). */
  locale?: Locale;
  /** schema.org JSON-LD for this page (ProfilePage on home, TechArticle on case studies). */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalURL,
  ogType = 'website',
  locale = localeFromPath(Astro.url.pathname),
  jsonLd,
} = Astro.props;
const ogImage = Astro.props.ogImage ?? ogImagePath('home', locale);
const ogImageAlt =
  Astro.props.ogImageAlt ??
  t(locale).meta.ogAltHome(profile.name, getProfile(locale).title, getProfile(locale).location);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suvamadhikary.vercel.app';
const pageUrl = canonicalURL || new URL(Astro.url.pathname, siteUrl).toString();
const fullOgImage = new URL(ogImage, siteUrl).toString();

// Every page exists in both locales, so each page lists itself and its translation.
const basePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(localizePath(basePath, l), siteUrl).toString(),
}));
const xDefault = new URL(localizePath(basePath, defaultLocale), siteUrl).toString();
const otherLocales = locales.filter((l) => l !== locale);
// Returning visitors who chose 日本語 in the header switcher get the Japanese page.
// Only on a fresh entry (typed URL, bookmark, external link): never on back/forward or
// reload, and never when coming from another page of this site, so the back button and
// explicit English visits keep working. Crawlers have no stored choice; `?lang=en`
// always stays in English. Runs before first paint, so there is no flash.
const localeRedirect = `(()=>{try{if(localStorage.getItem('locale')!=='ja')return;const n=performance.getEntriesByType('navigation')[0];if(n&&n.type!=='navigate')return;if(document.referrer&&new URL(document.referrer).origin===location.origin)return;if(/[?&]lang=en(&|$)/.test(location.search))return;location.replace('/ja'+location.pathname+location.search+location.hash)}catch(e){}})();`;

import '@fontsource-variable/inter';
// Global Tailwind styles for every page (previously only imported by index.astro,
// so case study pages shipped with no Tailwind CSS at all)
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import profile from '../../data/profile.json';
import {
  defaultLocale,
  htmlLang,
  localeFromPath,
  localizePath,
  locales,
  ogLocale,
  stripLocale,
  type Locale,
} from '../i18n/config';
import { getProfile } from '../i18n/content';
import { t } from '../i18n/ui';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, SITE_NAME, ogImagePath } from '../lib/seo';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="google-site-verification" content="XxkknNLQgM-ucPO_lKy68Tw8eaVof65HLFIyrwmo9iY" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {otherLocales.map((l) => (
      <meta property="og:locale:alternate" content={ogLocale[l]} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Icons, web app manifest and browser UI colour (icons: npm run og:generate) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The manifest link is added after load (see below): a static link makes Chrome fetch
         /site.webmanifest during load, which Lighthouse's network-dependency-tree-insight
         counts as a critical chain (document -> manifest) and fails in CI. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#030712" />

    <!-- Self-hosted Inter Variable (latin subset preloaded) -->
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />

    {locale === defaultLocale && <script is:inline set:html={localeRedirect} />}
    <script is:inline>
      // Dark mode initialization (runs before first paint to avoid FOUC).
      // Explicit choice in localStorage wins; otherwise follow prefers-color-scheme.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          stored = null;
        }
        const isDark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      })();
    </script>
    <script is:inline>
      // Attach the web app manifest once the page has loaded and the main thread is idle, so
      // it never joins the critical request chain. Browsers pick up a manifest link added
      // later (install prompt, home-screen name and icons work the same).
      addEventListener(
        'load',
        () => {
          const add = () => {
            if (document.querySelector('link[rel="manifest"]')) return;
            const link = document.createElement('link');
            link.rel = 'manifest';
            link.href = '/site.webmanifest';
            document.head.append(link);
          };
          if ('requestIdleCallback' in window) requestIdleCallback(add, { timeout: 2000 });
          else setTimeout(add, 200);
        },
        { once: true }
      );
    </script>
    <slot name="head" />
  </head>
  <body
    id="top"
    class="min-h-dvh overflow-x-clip bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors"
  >
    <slot />
  </body>
</html>
