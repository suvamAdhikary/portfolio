---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyNav from '../../components/StickyNav.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const caseStudies = (await getCollection('case-studies'))
    .filter((cs) => !cs.data.draft)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  return caseStudies.map((study, idx) => ({
    params: { slug: study.id },
    props: {
      study,
      prev: idx > 0 ? caseStudies[idx - 1] : undefined,
      next: idx < caseStudies.length - 1 ? caseStudies[idx + 1] : undefined,
    },
  }));
}

interface Props {
  study: CollectionEntry<'case-studies'>;
  prev?: CollectionEntry<'case-studies'>;
  next?: CollectionEntry<'case-studies'>;
}

const { study, prev, next } = Astro.props;
const { Content, headings } = await render(study);
const toc = headings.filter((h) => h.depth === 2);

const formattedDate = study.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Derived from the article body (not a content claim)
const wordCount = (study.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://suvamadhikary.vercel.app';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: study.data.title,
  description: study.data.description,
  datePublished: study.data.publishDate.toISOString(),
  keywords: study.data.tags.join(', '),
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Person', name: 'Suvam Adhikary', url: siteUrl },
};
---

<BaseLayout
  title={`${study.data.title} | Suvam Adhikary`}
  description={study.data.description}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <StickyNav />
  <CommandPalette />

  <main class="relative overflow-hidden">
    <!-- Ambient background -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[36rem] -z-10">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[48rem] h-[48rem] rounded-full bg-primary-500/10 dark:bg-primary-500/15 blur-3xl"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(100,116,139,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(100,116,139,0.08)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-20">
      <nav aria-label="Breadcrumb" class="max-w-6xl mx-auto mb-8">
        <a
          href="/#case-studies"
          class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-primary-700 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 transition-colors"
        >
          <svg
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            ></path>
          </svg>
          All case studies
        </a>
      </nav>

      <!-- Header card -->
      <header class="max-w-6xl mx-auto mb-12 rounded-3xl border border-gray-200/80 dark:border-white/10 bg-white/70 dark:bg-gray-900/60 backdrop-blur-xl shadow-xl shadow-primary-500/5 p-6 sm:p-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/30 border border-primary-200/70 dark:border-primary-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
          Case Study
        </span>

        <h1 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white text-balance">
          {study.data.title}
        </h1>

        <p class="mt-5 text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-3xl">
          {study.data.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-600 dark:text-gray-400">
          <time
            datetime={study.data.publishDate.toISOString()}
            class="inline-flex items-center gap-2"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {formattedDate}
          </time>
          <span class="inline-flex items-center gap-2">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            {readingMinutes} min read
          </span>
        </div>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack and topics">
          {study.data.tags.map((tag) => (
            <li class="px-3 py-1.5 rounded-lg text-xs font-mono text-gray-700 dark:text-gray-200 bg-gray-100/80 dark:bg-white/5 border border-gray-200 dark:border-white/10">
              {tag}
            </li>
          ))}
        </ul>
      </header>

      <!-- Mobile/tablet table of contents (the sidebar TOC is desktop-only) -->
      {toc.length > 1 && (
        <details class="lg:hidden max-w-6xl mx-auto mb-6 rounded-2xl border border-gray-200/80 dark:border-white/10 bg-white/70 dark:bg-gray-900/60 backdrop-blur-xl">
          <summary class="flex min-h-12 cursor-pointer items-center justify-between px-5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-primary-500 rounded-2xl">
            <span class="font-mono uppercase tracking-wider text-xs text-gray-600 dark:text-gray-300">
              On this page
            </span>
            <svg
              class="w-4 h-4 transition-transform [details[open]_&]:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              ></path>
            </svg>
          </summary>
          <ol class="px-3 pb-3 text-sm">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="toc-link flex min-h-11 items-center rounded-lg px-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class="max-w-6xl mx-auto lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
        <!-- Article body -->
        <article
          class="prose prose-gray dark:prose-invert max-w-none sm:prose-lg prose-pre:max-w-full prose-pre:overflow-x-auto
          prose-headings:scroll-mt-28 prose-headings:tracking-tight
          prose-h2:mt-14 prose-h2:pb-3 prose-h2:border-b prose-h2:border-gray-200 dark:prose-h2:border-white/10
          prose-a:text-primary-700 dark:prose-a:text-primary-300 prose-a:font-medium prose-a:underline-offset-4
          prose-strong:text-gray-900 dark:prose-strong:text-white
          prose-li:marker:text-primary-500
          prose-code:before:content-none prose-code:after:content-none prose-code:font-mono prose-code:text-[0.875em] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:bg-gray-100 dark:prose-code:bg-white/10 prose-code:text-primary-700 dark:prose-code:text-primary-300
          prose-pre:rounded-2xl prose-pre:border prose-pre:border-gray-200 dark:prose-pre:border-white/10 prose-pre:shadow-sm prose-pre:text-sm
          prose-blockquote:border-l-primary-500 prose-blockquote:bg-primary-50/60 dark:prose-blockquote:bg-primary-900/10 prose-blockquote:rounded-r-xl prose-blockquote:py-1
          prose-table:text-sm prose-th:text-left
          prose-img:rounded-2xl prose-img:border prose-img:border-gray-200 dark:prose-img:border-white/10
          prose-hr:border-gray-200 dark:prose-hr:border-white/10
          rounded-3xl border border-gray-200/80 dark:border-white/10 bg-white/60 dark:bg-gray-900/40 backdrop-blur-xl p-5 sm:p-10 min-w-0"
        >
          <Content />
        </article>

        <!-- Table of contents -->
        {toc.length > 1 && (
          <aside class="hidden lg:block" aria-label="On this page">
            <div class="sticky top-28 rounded-2xl border border-gray-200/80 dark:border-white/10 bg-white/60 dark:bg-gray-900/40 backdrop-blur-xl p-5">
              <p class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
                On this page
              </p>
              <ol class="space-y-2 text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="toc-link block py-1 text-gray-600 dark:text-gray-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )}
      </div>

      <!-- Prev / next -->
      <nav aria-label="More case studies" class="max-w-6xl mx-auto mt-16 grid gap-4 sm:grid-cols-2">
        {prev ? (
          <a
            href={`/case-studies/${prev.id}/`}
            class="group rounded-2xl border border-gray-200/80 dark:border-white/10 bg-white/60 dark:bg-gray-900/40 backdrop-blur-xl p-6 transition-all hover:-translate-y-0.5 hover:border-primary-500/50 hover:shadow-lg"
          >
            <span class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400">
              ← Previous
            </span>
            <span class="mt-2 block font-semibold text-gray-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}
        {next ? (
          <a
            href={`/case-studies/${next.id}/`}
            class="group rounded-2xl border border-gray-200/80 dark:border-white/10 bg-white/60 dark:bg-gray-900/40 backdrop-blur-xl p-6 text-right transition-all hover:-translate-y-0.5 hover:border-primary-500/50 hover:shadow-lg"
          >
            <span class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400">
              Next →
            </span>
            <span class="mt-2 block font-semibold text-gray-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300">
              {next.data.title}
            </span>
          </a>
        ) : (
          <a
            href="/#case-studies"
            class="group rounded-2xl border border-gray-200/80 dark:border-white/10 bg-white/60 dark:bg-gray-900/40 backdrop-blur-xl p-6 text-right transition-all hover:-translate-y-0.5 hover:border-primary-500/50 hover:shadow-lg"
          >
            <span class="text-xs font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400">
              Back to
            </span>
            <span class="mt-2 block font-semibold text-gray-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300">
              All case studies
            </span>
          </a>
        )}
      </nav>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Render ```mermaid fences (excluded from Shiki) as diagrams, themed to match light/dark.
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre > code.language-mermaid'));

  if (blocks.length > 0) {
    const containers = blocks.map((code) => {
      const pre = code.parentElement as HTMLElement;
      const figure = document.createElement('figure');
      figure.className = 'mermaid-diagram not-prose';
      figure.dataset.source = code.textContent ?? '';
      figure.setAttribute('role', 'img');
      figure.setAttribute('aria-label', 'Architecture diagram');
      pre.replaceWith(figure);
      return figure;
    });

    const renderAll = async () => {
      const { default: mermaid } = await import('mermaid');
      const isDark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'strict',
      });
      for (const [i, el] of containers.entries()) {
        try {
          const { svg } = await mermaid.render(
            `mermaid-${i}-${Date.now()}`,
            el.dataset.source ?? ''
          );
          el.innerHTML = svg;
        } catch {
          el.innerHTML = '';
          const fallback = document.createElement('pre');
          fallback.textContent = el.dataset.source ?? '';
          el.appendChild(fallback);
        }
      }
    };

    // Load the (large) mermaid bundle only when a diagram approaches the viewport.
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      renderAll();
      new MutationObserver(() => renderAll()).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      },
      { rootMargin: '400px 0px' }
    );
    containers.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .mermaid-diagram {
    margin: 2rem 0;
    padding: 1.5rem;
    overflow-x: auto;
    border-radius: 1rem;
    border: 1px solid rgb(229 231 235);
    background: rgb(255 255 255 / 0.7);
    text-align: center;
  }
  .dark .mermaid-diagram {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(17 24 39 / 0.5);
  }
  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
</style>
