---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyNav from '../components/StickyNav.astro';
import AnimatedHero from '../components/AnimatedHero.astro';
import BentoHighlights from '../components/BentoHighlights.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Footer from '../components/Footer.astro';
import Builds from '../components/Builds.astro';
import { getCollection } from 'astro:content';
import profile from '../../data/profile.json';

const caseStudies = (await getCollection('case-studies'))
  .filter((cs) => !cs.data.draft)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 3);

// GitHub API integration for projects
let githubProjects: any[] = [];
try {
  const token = import.meta.env.GITHUB_TOKEN;
  const headers: HeadersInit = {
    Accept: 'application/vnd.github.v3+json',
  };
  if (token) {
    headers['Authorization'] = `token ${token}`;
  }

  const response = await fetch(
    'https://api.github.com/users/suvamAdhikary/repos?sort=updated&per_page=100',
    {
      headers,
    }
  );

  if (response.ok) {
    const repos = await response.json();
    githubProjects = repos
      .filter((repo: any) => !repo.fork && !repo.archived)
      .sort(
        (a: any, b: any) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime()
      );
  }
} catch (error) {
  console.warn('Failed to fetch GitHub projects:', error);
}

// Curated project lists
const featuredProjectNames = [
  'workflow-engine-backend',
  'visucode',
  'identity-reconciliation',
  'logic-composer',
  'workflow-engine-frontend',
];

const bootcampProjectNames = [
  'Capdas-ECommerce',
  'dineout_clone',
  'Rhythm',
  'MyGlamm-with-Backend',
  'deliveroo-clone',
];

// Manual descriptions for projects (used as fallback if API fails or description is missing)
const projectDescriptions: Record<string, string> = {
  'workflow-engine-backend':
    'Production-ready NestJS backend for workflow automation platform. Features JWT auth, API keys, workflow CRUD, webhook execution, Redis caching, and comprehensive API documentation.',
  visucode:
    '🎓 Interactive DSA learning platform — visual lessons, step-by-step dry runs, built-in code editor. Learn algorithms by seeing, not just reading.',
  'identity-reconciliation':
    'REST API for linking customer contacts across emails and phone numbers using TypeScript and SQL',
  'logic-composer':
    'A Visual Condition Builder built with React and TypeScript that allows users to construct nested logical expressions using groups and rules. This project focuses on clean state modeling, immutable updates, recursive rendering, and correctness.',
  'workflow-engine-frontend':
    'React frontend for workflow automation platform. Built with Vite, TypeScript, and Tailwind CSS. Features workflow builder, execution history, and real-time monitoring.',
  'Capdas-ECommerce':
    'Sustainable clothing e-commerce (mobile version) built with MERN stack. First team project with design collaboration.',
  dineout_clone:
    'Restaurant booking web app with filtering, date/time selection, mobile OTP login, and booking confirmations.',
  Rhythm:
    'MERN stack music platform where users can discover albums by filtering and searching, and artists can showcase their work.',
  'MyGlamm-with-Backend':
    'Luxury beauty products e-commerce with product details, cart, and checkout functionality.',
  'deliveroo-clone': 'Food delivery app with Sanity.io backend, multiplatform support.',
};

// Build featured projects list in specified order
const featuredProjects = featuredProjectNames.map((name) => {
  const repo = githubProjects.find((r: any) => r.name === name);
  if (repo) {
    // Use API data but ensure description is set
    return {
      ...repo,
      description: repo.description || projectDescriptions[name] || '',
    };
  }
  // Fallback if API failed or repo not found
  return {
    name,
    html_url: `https://github.com/suvamAdhikary/${name}`,
    description: projectDescriptions[name] || '',
    language: name.includes('backend')
      ? 'TypeScript'
      : name === 'visucode'
        ? 'TypeScript'
        : 'TypeScript',
    stargazers_count: 0,
    forks_count: 0,
  };
});

// Build bootcamp projects list
const bootcampProjects = bootcampProjectNames.map((name) => {
  const repo = githubProjects.find((r: any) => r.name === name);
  if (repo) {
    return {
      ...repo,
      description: repo.description || projectDescriptions[name] || '',
    };
  }
  return {
    name,
    html_url: `https://github.com/suvamAdhikary/${name}`,
    description: projectDescriptions[name] || '',
    language: 'JavaScript',
    stargazers_count: 0,
    forks_count: 0,
  };
});
---

<BaseLayout title={`${profile.name} | ${profile.title}`} description={profile.tagline}>
  <StickyNav />
  <CommandPalette />

  <main>
    <AnimatedHero />
    <BentoHighlights />

    <!-- About Section -->
    <section id="about" class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-32">
      <ScrollReveal>
        <div class="max-w-5xl">
          <div class="inline-block mb-4">
            <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
              About
            </span>
          </div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-12 leading-tight">
            Building{' '}
            <span class="bg-gradient-to-r from-primary-600 to-primary-500 bg-clip-text text-transparent">
              production systems
            </span>{' '}
            that scale
          </h2>

          <div class="grid md:grid-cols-2 gap-12">
            <div class="space-y-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
              <p>
                I'm a Backend Engineer with 4.5+ years of experience building and hardening
                production APIs, microservices, and event-driven systems. Currently at Neutrinos in
                Bengaluru, I work on Node.js/TypeScript APIs for an enterprise insurance platform,
                focusing on security, performance, and Kubernetes deployments.
              </p>
              <p>
                My expertise spans managing Kafka producers and consumers processing 100K+
                events/day across 21+ microservices, optimizing MongoDB aggregations to improve
                throughput by 5x, and implementing GraphQL Federation gateways that reduced
                production incidents by 60%.
              </p>
            </div>

            <div class="space-y-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
              <p>
                I've delivered backend infrastructure for platforms serving 15K+ active learners and
                built offline-first sync systems with conflict resolution for classrooms with
                unreliable connectivity.
              </p>
              <p>
                I transitioned into software engineering from a mechanical engineering background,
                completing a Full-Stack Web Development certification from Masai School in 2021.
                Starting with my first backend role at Lead School, I've grown from building REST
                APIs to owning microservices architectures and leading technical design.
              </p>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </section>

    <!-- Experience Section -->
    <section
      id="experience"
      class="relative py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900/50 dark:to-gray-950"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="inline-block mb-4">
            <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
              Experience
            </span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold mb-16">Career Journey</h2>
        </ScrollReveal>

        <div class="max-w-5xl space-y-16">
          {profile.experience.map((exp, idx) => (
            <ScrollReveal delay={`${idx * 0.1}s`}>
              <div class="group relative">
                <div class="absolute -left-4 top-0 bottom-0 w-px bg-gradient-to-b from-primary-500 via-primary-400 to-transparent hidden md:block"></div>
                <div class="absolute -left-6 top-8 w-4 h-4 rounded-full bg-primary-600 border-4 border-white dark:border-gray-950 hidden md:block group-hover:scale-125 transition-transform"></div>

                <div class="md:pl-8 p-6 md:p-8 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-primary-500/50 dark:hover:border-primary-500/50 transition-all hover:shadow-xl group-hover:-translate-y-1">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
                    <div class="flex-1">
                      <h3 class="text-2xl font-bold mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {exp.position}
                      </h3>
                      <p class="text-xl text-gray-700 dark:text-gray-300 font-medium">
                        {exp.company}
                      </p>
                    </div>
                    {exp.current && (
                      <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 rounded-full text-sm font-medium">
                        <span class="w-2 h-2 bg-green-600 rounded-full animate-pulse"></span>
                        Current
                      </span>
                    )}
                  </div>

                  <div class="flex flex-wrap gap-3 text-sm font-mono text-gray-600 dark:text-gray-400 mb-6">
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                      {new Date(exp.startDate).toLocaleDateString('en-US', {
                        month: 'short',
                        year: 'numeric',
                      })}{' '}
                      -
                      {exp.current
                        ? 'Present'
                        : new Date(exp.endDate!).toLocaleDateString('en-US', {
                            month: 'short',
                            year: 'numeric',
                          })}
                    </span>
                    <span class="text-gray-400 dark:text-gray-600">•</span>
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                      </svg>
                      {exp.location}
                    </span>
                  </div>

                  <ul class="space-y-3 text-gray-700 dark:text-gray-300">
                    {exp.highlights.map((highlight) => (
                      <li class="flex gap-3">
                        <svg
                          class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span class="leading-relaxed">{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Case Studies Section -->
    <section id="case-studies" class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-32">
      <ScrollReveal>
        <div class="inline-block mb-4">
          <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
            Case Studies
          </span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Technical Deep Dives</h2>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-16 max-w-3xl">
          Real-world problems, architecture decisions, and measurable results from production
          systems.
        </p>
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {caseStudies.map((study, idx) => (
          <ScrollReveal delay={`${idx * 0.1}s`}>
            <a href={`/case-studies/${study.id}`} class="group relative block h-full">
              <div class="absolute inset-0 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-opacity"></div>
              <div class="relative h-full p-8 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white dark:bg-gray-900 hover:border-transparent transition-all group-hover:-translate-y-2 group-hover:shadow-2xl">
                <div class="flex items-start justify-between mb-4">
                  <div class="p-3 rounded-xl bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      />
                    </svg>
                  </div>
                  <svg
                    class="w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </div>

                <h3 class="text-2xl font-bold mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors leading-tight">
                  {study.data.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                  {study.data.description}
                </p>

                <div class="flex flex-wrap gap-2 mt-auto">
                  {study.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-sm rounded-lg font-mono text-gray-700 dark:text-gray-300">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </section>

    <!-- Projects Section -->
    <section
      id="projects"
      class="relative py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900/50 dark:to-gray-950"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="inline-block mb-4">
            <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
              Projects
            </span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Open Source & Side Projects</h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 mb-16">
            Selected work from my GitHub showcasing full-stack development and system design.
          </p>
        </ScrollReveal>

        {featuredProjects.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
            {featuredProjects.map((project: any, idx: number) => (
              <ScrollReveal delay={`${idx * 0.05}s`}>
                <div class="group relative block h-full">
                  <div class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-opacity"></div>
                  <div class="relative h-full p-6 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm hover:border-primary-500/50 transition-all group-hover:-translate-y-1 group-hover:shadow-xl">
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center gap-2 flex-1">
                        <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                        </svg>
                        <h3 class="text-lg font-bold font-mono truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                          <a
                            href={project.html_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="after:absolute after:inset-0 after:rounded-2xl after:content-['']"
                          >
                            {project.name}
                          </a>
                        </h3>
                      </div>
                      {project.name === 'visucode' && (
                        <a
                          href="https://visucode.vercel.app"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="relative z-10 ml-2 px-2.5 py-1 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 text-xs rounded-lg font-medium hover:bg-green-200 dark:hover:bg-green-900/50 flex items-center gap-1 whitespace-nowrap"
                        >
                          <svg
                            class="w-3 h-3"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                            />
                          </svg>
                          Live
                        </a>
                      )}
                    </div>
                    {project.description && (
                      <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 leading-relaxed line-clamp-3">
                        {project.description}
                      </p>
                    )}
                    {project.name === 'visucode' && (
                      <p class="text-xs font-mono text-gray-500 dark:text-gray-500 mb-4 flex items-center gap-2">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        29 test files • TypeScript/Nx/Next.js
                      </p>
                    )}
                    <div class="flex items-center gap-4 text-xs font-mono text-gray-500 dark:text-gray-500">
                      {project.language && (
                        <span class="flex items-center gap-1.5">
                          <span class="w-2 h-2 rounded-full bg-primary-500"></span>
                          {project.language}
                        </span>
                      )}
                      {project.stargazers_count > 0 && (
                        <span class="flex items-center gap-1">
                          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                          {project.stargazers_count}
                        </span>
                      )}
                      {project.forks_count > 0 && (
                        <span class="flex items-center gap-1">
                          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-.878a2.25 2.25 0 111.5 0v.878a2.25 2.25 0 01-2.25 2.25h-1.5v2.128a2.251 2.251 0 11-1.5 0V8.5h-1.5A2.25 2.25 0 013.5 6.25v-.878a2.25 2.25 0 111.5 0zM5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm6.75.75a.75.75 0 100-1.5.75.75 0 000 1.5zm-3 8.75a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                          </svg>
                          {project.forks_count}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        ) : (
          <div class="text-gray-600 dark:text-gray-400 mb-16 p-8 border border-gray-200 dark:border-gray-800 rounded-2xl text-center">
            <p>Unable to load projects. Check GitHub API access.</p>
          </div>
        )}

        {bootcampProjects.length > 0 && (
          <ScrollReveal>
            <div class="pt-8 border-t border-gray-200 dark:border-gray-800">
              <h3 class="text-2xl font-bold mb-2">Earlier Work</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-8">
                Bootcamp and team projects from 2021-23 learning journey at Masai School
              </p>
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                {bootcampProjects.map((project: any) => (
                  <a
                    href={project.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group p-4 border border-gray-200 dark:border-gray-800 rounded-xl hover:border-primary-500 dark:hover:border-primary-400 transition-all hover:shadow-lg hover:-translate-y-1 bg-white/50 dark:bg-gray-900/50 backdrop-blur-sm"
                  >
                    <div class="flex items-start gap-2 mb-2">
                      <svg
                        class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5"
                        fill="currentColor"
                        viewBox="0 0 16 16"
                      >
                        <path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z" />
                      </svg>
                      <h4 class="font-semibold text-sm truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {project.name}
                      </h4>
                    </div>
                    {project.description && (
                      <p class="text-xs text-gray-600 dark:text-gray-400 mb-2 line-clamp-2 leading-relaxed">
                        {project.description}
                      </p>
                    )}
                    {project.language && (
                      <span class="inline-flex items-center gap-1 text-xs font-mono text-gray-500 dark:text-gray-500">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                        {project.language}
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </ScrollReveal>
        )}
      </div>
    </section>

    <!-- Builds Section -->
    <Builds />

    <!-- Skills Section -->
    <section id="skills" class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-32">
      <ScrollReveal>
        <div class="inline-block mb-4">
          <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
            Skills
          </span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-16">Technologies & Tools</h2>
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {Object.entries(profile.skills).map(([category, skillList], idx) => (
          <ScrollReveal delay={`${idx * 0.1}s`}>
            <div class="group p-8 border border-gray-200 dark:border-gray-800 rounded-2xl bg-gradient-to-br from-white to-gray-50 dark:from-gray-900 dark:to-gray-900/50 hover:border-primary-500/50 transition-all hover:shadow-xl hover:-translate-y-1">
              <div class="flex items-center gap-3 mb-6">
                <div class="p-2 rounded-lg bg-primary-100 dark:bg-primary-900/30">
                  <svg
                    class="w-5 h-5 text-primary-600 dark:text-primary-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {category}
                </h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {(skillList as string[]).map((skill) => (
                  <span class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm font-medium hover:border-primary-500 dark:hover:border-primary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </section>

    <!-- Education Section -->
    <section
      id="education"
      class="relative py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900/50 dark:to-gray-950"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="inline-block mb-4">
            <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
              Education
            </span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold mb-16">Academic Background</h2>
        </ScrollReveal>

        <div class="max-w-4xl grid md:grid-cols-2 gap-8">
          {profile.education.map((edu, idx) => (
            <ScrollReveal delay={`${idx * 0.1}s`}>
              <div class="group p-8 border border-gray-200 dark:border-gray-800 rounded-2xl bg-white dark:bg-gray-900 hover:border-primary-500/50 transition-all hover:shadow-xl hover:-translate-y-1">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 mb-6 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 14l9-5-9-5-9 5 9 5z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {edu.degree}
                </h3>
                <p class="text-lg text-gray-700 dark:text-gray-300 mb-3 font-medium">
                  {edu.institution}
                </p>
                <p class="text-sm font-mono text-gray-600 dark:text-gray-400">
                  {edu.type === 'certification' ? edu.year : `${edu.startYear} - ${edu.endYear}`}
                </p>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-32">
      <ScrollReveal>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block mb-4">
            <span class="text-sm font-mono text-primary-600 dark:text-primary-400 tracking-wider uppercase">
              Contact
            </span>
          </div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Let's Work Together</h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed">
            I'm always interested in hearing about new opportunities, interesting projects, or just
            having a chat about technology.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
            <a
              href={`mailto:${profile.email}`}
              class="group relative px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-medium text-lg transition-all hover:shadow-lg hover:shadow-primary-500/50 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 w-full sm:w-auto"
            >
              <span class="flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
                Send me an email
              </span>
            </a>

            <a
              href={profile.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group px-8 py-4 border-2 border-gray-300 dark:border-gray-700 hover:border-primary-600 dark:hover:border-primary-400 rounded-xl font-medium text-lg transition-all hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 w-full sm:w-auto"
            >
              <span class="flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                Connect on LinkedIn
              </span>
            </a>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-gray-600 dark:text-gray-400">
            <a
              href={profile.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              GitHub
            </a>
            <span>•</span>
            <span class="font-mono break-all">{profile.email}</span>
            <span>•</span>
            <span>{profile.location}</span>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </main>

  <Footer />
</BaseLayout>
